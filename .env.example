# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Any OpenAI-compatible endpoint works (OpenRouter, OpenAI, Gemini, Groq, Ollama, ...).
# Example: OpenRouter free model
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional.
# Reasoning effort: minimal | low | medium | high. Leave empty for models without reasoning.
LLM_REASONING_EFFORT=low
# Seconds between calls. OpenRouter free models allow 20 requests/minute, so 3.5 stays under it.
LLM_MIN_INTERVAL_S=3.5
# SDK retries on 429 / 5xx, with backoff.
LLM_MAX_RETRIES=6
# Cap on one reply, hidden reasoning included. Without it a free model once reasoned for 32 minutes.
LLM_MAX_TOKENS=8000
